# Optional: defaults match the existing production service and share URLs.
VITE_API_URL=https://api.luvnote.fun
VITE_SITE_URL=https://luvnote.fun

# Rollout switch. Keep false until the R2 bucket, D1 schema and Turnstile are configured.
VITE_R2_MEDIA_ENABLED=false
# Public Cloudflare Turnstile site key (NOT the secret key).
VITE_TURNSTILE_SITE_KEY=
